# DSA AI Coach Environment Configuration

# Database
DSA_DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5433/dsa_db

# Redis
DSA_REDIS_URL=redis://localhost:6380/0

# Security (Replace with securely generated keys for production)
DSA_SECRET_KEY=change_me_to_a_secure_random_string
DSA_ALGORITHM=HS256
DSA_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (NVIDIA NIM configuration)
DSA_AI_PROVIDER=nvidia
DSA_NVIDIA_API_KEY=your_nvidia_api_key_here
DSA_AI_MODEL=meta/llama-3.1-70b-instruct

# Application Settings
DSA_ENVIRONMENT=development
DSA_CORS_ORIGINS=http://localhost:5173
